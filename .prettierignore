.venv/
venv/
env/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
**/*.egg-info/
# Frontend dependencies and generated bundles
**/node_modules/
dist/
build/
**/static/vendor/
**/*.min.js
**/*.min.css
**/*.map
# Django collected static assets and private/generated files.
# Keep authored files in static/ and <app>/static/ formattable.
staticfiles/
private/
media/
run/
logs/
backups/
**/*.log
**/*.sqlite3
**/*.sqlite3-journal
**/celerybeat-schedule*
# Secrets and local environment configuration
.env
.env.*
!.env.prod.example
