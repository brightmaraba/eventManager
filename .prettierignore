# Django templates: keep template tags/filters and embedded template syntax
# out of Prettier's generic HTML, JavaScript and CSS parsers.
# Covers both project-level templates/ and app-level <app>/templates/.
**/templates/**
**/*.djhtml
**/*.django
**/*.html.j2
**/*.jinja
**/*.jinja2
